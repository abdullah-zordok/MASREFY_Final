# Public configuration keys for the Masarifi mobile app.
# Copy to `.env` and adjust values. Never commit a real `.env`.
#
# All keys here are safe to expose in the client bundle. Secrets belong in
# Expo SecureStore or a server, never in this file.

# Explicit client runtime. Production accepts only `live`; `demo` and `test`
# keep deterministic fixtures outside production.
EXPO_PUBLIC_CLIENT_MODE=live

# Public production API origin. Live mode requires HTTPS.
EXPO_PUBLIC_API_URL=https://api.example.com

# Public Clerk frontend identifier. Production requires a `pk_live_` key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_public_key

# Selected Expo development client URL (set automatically by `expo start`).
# EXPO_PUBLIC_APP_ORIGIN=
