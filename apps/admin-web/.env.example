# Public values embedded in the Admin browser bundle. Do not place secrets here.
NEXT_PUBLIC_CLIENT_MODE=live
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_public_key

# Server-only. Required for production Clerk middleware; never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=sk_live_replace_with_server_key

# Development-only deterministic fixtures. Production validation rejects `true`.
NEXT_PUBLIC_ENABLE_MOCKS=false
