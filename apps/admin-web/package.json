{
  "name": "masarifi-admin-prototype",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:sites": "vinext build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --config=playwright.performance.config.ts && playwright test --project=desktop-1440 && playwright test --project=desktop-1280 && playwright test --project=tablet-1024 && playwright test --project=tablet-768 && playwright test --project=mobile-390"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.6",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "latest",
    "next": "16.3.8",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.83.0",
    "recharts": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^30.0.0",
    "msw": "^2.15.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "source-map-js": "1.2.2",
    "undici@^7.0.0": "7.29.1",
    "undici@^8.0.0": "8.10.2",
    "fast-uri@^3.0.0": "3.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
