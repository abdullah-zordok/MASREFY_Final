{
  "name": "@masarifi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Masarifi backend API and worker",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build api && nest build worker && nest build migration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:contract": "jest --selectProjects contract --runInBand",
    "test:http": "jest --selectProjects contract --runInBand health.contract-spec.ts meta.contract-spec.ts http-validation.contract-spec.ts http-security.contract-spec.ts",
    "test:openapi": "jest --selectProjects contract --runInBand openapi-drift.contract-spec.ts",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:ledger:integration": "jest --selectProjects integration --runInBand --testPathPatterns=ledger",
    "test:database:integration": "jest --selectProjects integration --runInBand enqueue.spec.ts concurrent-claim.spec.ts lease-recovery.spec.ts queue-recovery.spec.ts",
    "test:migration": "jest --selectProjects e2e --runInBand migration-apply.e2e-spec.ts migration-checksum.e2e-spec.ts migration-concurrency.e2e-spec.ts backup-restore.e2e-spec.ts",
    "test:foundation:e2e": "jest --selectProjects e2e --runInBand local-foundation.e2e-spec.ts",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:ledger:recovery": "jest --selectProjects e2e --runInBand --runTestsByPath test/e2e/backup-restore.e2e-spec.ts test/e2e/ledger/ledger-recovery.e2e-spec.ts",
    "test:ledger:security": "jest --selectProjects security --runInBand --testPathPatterns=ledger",
    "test:container": "jest --selectProjects container --runInBand",
    "test:release-image": "npm run image:build && npm run test:container",
    "test:outbox:logic": "jest --selectProjects unit contract integration --runInBand --testPathPatterns=outbox",
    "test:outbox:performance": "ts-node test/performance/run-outbox-k6.ts",
    "test:outbox": "npm run perf:clean:outbox && npm run test:outbox:logic && npm run perf:seed:outbox && npm run perf:explain:outbox && npm run test:outbox:performance",
    "test:performance:platform": "ts-node test/performance/run-platform-http.ts",
    "test:performance": "npm run test:performance:platform",
    "test:stress": "ts-node test/performance/run-outbox-k6.ts --stress",
    "perf:check": "node --check test/performance/platform-http.k6.js && node --check test/performance/outbox-dispatch.k6.js && node --check test/performance/ledger.k6.js && node --check test/performance/sync.k6.js && node --check test/performance/planning.k6.js && node --check test/performance/tracking.k6.js && node --check test/performance/ai.k6.js && node --check test/performance/identity-profile.k6.js && node --check test/performance/identity-devices.k6.js && node --check test/performance/clerk-webhook.k6.js && node --check test/performance/security-permission.k6.js && node --check test/performance/security-owner-events.k6.js && node --check test/performance/security-privacy-export.k6.js && node --check test/performance/security-deletion-retention.k6.js",
    "test:performance:security": "ts-node test/performance/run-security.ts",
    "test:performance:reference": "ts-node test/performance/run-reference.ts",
    "test:performance:ledger": "ts-node test/performance/run-ledger.ts",
    "test:performance:sync": "ts-node test/performance/run-sync.ts",
    "test:performance:planning": "ts-node test/performance/run-planning.ts",
    "test:performance:tracking": "ts-node test/performance/run-tracking.ts",
    "test:stress:tracking": "ts-node test/performance/run-tracking.ts --stress",
    "test:planning:integration": "jest --selectProjects integration --runInBand --testPathPatterns=planning",
    "test:planning:recovery": "jest --selectProjects e2e --runInBand --testPathPatterns=planning-recovery",
    "test:tracking:recovery": "jest --selectProjects e2e --runInBand --testPathPatterns=tracking-recovery",
    "test:ai:unit": "jest --selectProjects unit --runInBand --testPathPatterns=ai",
    "test:ai:contract": "jest --selectProjects contract --runInBand --testPathPatterns=ai",
    "test:ai:integration": "jest --selectProjects integration --runInBand --testPathPatterns=ai",
    "test:ai:security": "jest --selectProjects security --runInBand --testPathPatterns=ai",
    "test:ai:recovery": "jest --selectProjects e2e --runInBand --testPathPatterns=ai-recovery",
    "test:ai": "npm run test:ai:unit && npm run test:ai:contract && npm run test:ai:integration && npm run test:ai:security && npm run test:ai:recovery",
    "test:performance:ai": "ts-node test/performance/run-ai.ts",
    "test:stress:ai": "ts-node test/performance/run-ai.ts --stress",
    "test:planning:security": "jest --selectProjects security --runInBand --testPathPatterns=planning",
    "test:planning:logic": "jest --selectProjects unit contract security --runInBand --testPathPatterns=planning",
    "test:planning": "npm run test:planning:logic && npm run test:planning:integration",
    "test:sync:logic": "jest --selectProjects unit contract e2e --runInBand --testPathPatterns=sync",
    "test:sync:integration": "jest --selectProjects integration --runInBand --testPathPatterns=sync",
    "test:sync:security": "jest --selectProjects security --runInBand --testPathPatterns=sync",
    "test:sync:recovery": "jest --selectProjects e2e --runInBand --testPathPatterns=sync-recovery",
    "perf:clean:outbox": "ts-node test/performance/run-psql.ts test/performance/outbox-clean.sql",
    "perf:seed:outbox": "ts-node test/performance/run-psql.ts test/performance/outbox-seed.sql",
    "perf:explain:outbox": "ts-node test/performance/run-psql.ts test/performance/outbox-explain.sql",
    "supabase:start": "supabase start --workdir ../..",
    "supabase:stop": "supabase stop --workdir ../..",
    "db:reset": "supabase db reset --workdir ../..",
    "db:lint": "supabase db lint --workdir ../.. --schema public,private,audit --level error --fail-on error",
    "test:db": "supabase test db --workdir ../..",
    "migration:checksums": "ts-node src/platform/database/migration-checksums.ts",
    "migration:checksums:update": "ts-node src/platform/database/migration-checksums.ts --write",
    "admin:bootstrap": "ts-node src/security/admin-bootstrap.ts",
    "security:dependencies": "npm audit --audit-level=high",
    "security:sast": "npm run typecheck && npm run lint",
    "security:scope": "jest --selectProjects security --runInBand ownership-boundary.spec.ts scope-boundary.spec.ts",
    "security:workflow-pins": "jest --selectProjects security --runInBand",
    "verify": "npm run typecheck && npm run lint && npm run perf:check && npm run test:unit && npm run test:contract && npm run test:integration && npm run test:e2e && npm run build && npm run migration:checksums && npm run security:dependencies && npm run security:workflow-pins",
    "start:dev": "nest start api --watch",
    "start:worker:dev": "nest start worker --watch",
    "image:build": "docker build --file ../../docker/backend.Dockerfile --tag masarifi-backend:spec-be-001 ../..",
    "image:run:api": "docker run --rm masarifi-backend:spec-be-001 dist/src/main.js",
    "image:run:worker": "docker run --rm masarifi-backend:spec-be-001 dist/src/worker.js",
    "image:run:migration": "docker run --rm masarifi-backend:spec-be-001 dist/src/migration.js",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "start:migration": "node dist/src/migration.js"
  },
  "dependencies": {
    "@clerk/backend": "3.16.12",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "archiver": "7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "5.1.0",
    "helmet": "^8.0.0",
    "joi": "^18.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/archiver": "6.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "js-yaml": "5.3.0",
    "prettier": "^3.0.0",
    "supabase": "2.116.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
